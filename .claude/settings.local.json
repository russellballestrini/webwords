{
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(true)",
      "Bash(jobs)",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(curl:*)",
      "Bash(timeout:*)",
      "Bash(sudo lsof:*)",
      "Bash(make:*)",
      "Bash(./scripts/*)",
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(docker stop:*)",
      "Bash(docker rm:*)",
      "Bash(docker logs:*)",
      "Bash(docker exec:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker system:*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.remarkbox.com)",
      "Bash(mv:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo rm:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)"
    ]
  },
  "preferences": {
    "defaultDockerTimeout": "60s",
    "testingPort": "31337",
    "concurrentJobs": "auto",
    "buildCacheEnabled": true
  }
}